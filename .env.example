APP_NAME=Ruko
ENVIRONMENT=development
DATABASE_URL=sqlite:///./ruko.db

# LLM analyzer: "anthropic" or "none"
LLM_PROVIDER=anthropic
# Leave empty to let the provider SDK use its own env var (e.g. ANTHROPIC_API_KEY)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=15
LLM_MAX_TOKENS=4096

# Telegram (create a bot with @BotFather; use a SEPARATE dev bot for scripts/poll.py)
TELEGRAM_BOT_TOKEN=
# Random secret Telegram echoes back on each webhook call. Letters, digits, _ and - only.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Public https URL of this server, used only by scripts/set_webhook.py
PUBLIC_BASE_URL=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=10
TELEGRAM_MAX_CONCURRENT_ANALYSES=5

# Family Mode (Phase 3). OFF by default: with it off no database is opened and
# the bot behaves exactly as in Phase 2. After turning it on, re-run
# `python -m scripts.set_webhook` so Telegram sends button presses.
FAMILY_MODE_ENABLED=false
# Your bot's @username without the @ (used for invite links). Leave empty to look it up with getMe.
TELEGRAM_BOT_USERNAME=
FAMILY_INVITE_TTL_HOURS=48
FAMILY_CONSENT_TTL_HOURS=24
FAMILY_MAX_HELPERS=5
FAMILY_MAX_PENDING_INVITES=3
FAMILY_ALERT_MAX_PER_HOUR=5
FAMILY_ALERT_DEDUPE_MINUTES=30
FAMILY_ALERT_RETENTION_DAYS=30
EMERGENCY_DEDUPE_SECONDS=120
EMERGENCY_BUTTON_TTL_HOURS=24
